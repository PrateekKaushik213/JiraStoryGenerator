# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# Jira Cloud — create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# Optional: custom field id for story points (varies per Jira site, e.g. customfield_10016)
JIRA_STORY_POINTS_FIELD=

PORT=3000
